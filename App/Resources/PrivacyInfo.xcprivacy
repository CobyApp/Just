<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nothing here tracks anyone. Lyric analysis runs on device through
       Apple Intelligence, and the only network calls are the Apple Music
       catalog and LRCLIB — neither is given a user identifier. There is no
       analytics or ad SDK, so unlike the sibling `mana` app there is no
       third-party manifest to aggregate with this one. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <!-- Required-reason API declarations for APIs the app itself calls. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- UserDefaults: review reminder time, auto-analysis policy, lyric
           text size. All app settings, never read off-device. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
