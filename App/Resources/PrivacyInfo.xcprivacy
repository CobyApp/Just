<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- What the app itself does. Lyric analysis runs on device: the bundled
       dictionary and grammar list, plus Apple's system translator for the
       sentence. The app's own network calls are the iTunes lookup API (song
       list, artwork), the YouTube Data API and embedded player (video), and
       LRCLIB (lyrics); none of them is given a user identifier. There is no
       third-party SDK, no account and no analytics, so nothing is collected,
       linked to the user or used for tracking. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- UserDefaults: favourite group, review reminder time, daily goal,
           auto-analysis policy, lyric text size. All app settings, never read
           off-device. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
