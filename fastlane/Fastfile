default_platform(:ios)

WORKSPACE = "RingRing.xcworkspace"
SCHEME = "RingRing"
APP_IDENTIFIER = "com.coby.ringring"
TEAM_ID = "3Y8YH8GWMM"
# The App Store listing name (unique across the store) and its primary
# language, used to create the app record the first time this bundle id is
# uploaded. Change the name later in App Store Connect if needed.
APP_NAME = "링링 - 최애의 노래로 일본어"
APP_PRIMARY_LANGUAGE = "English (U.S.)"

# `tuist generate` bakes these into Info.plist. A missing one does not fail the
# build — it ships a build that quietly misbehaves (every song a 30-second
# preview) — so the upload lane checks them first.
def verify_release_environment!
  problems = []

  problems << "TUIST_YOUTUBE_API_KEY is not set" if ENV["TUIST_YOUTUBE_API_KEY"].to_s.strip.empty?

  version = ENV["TUIST_MARKETING_VERSION"].to_s.strip
  unless version.empty? || version.match?(/\A\d+(\.\d+){1,2}\z/)
    problems << "TUIST_MARKETING_VERSION '#{version}' is not a version like 1.2.0"
  end

  return if problems.empty?

  UI.user_error!("Refusing to build for TestFlight:\n  - #{problems.join("\n  - ")}")
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run the unit tests"
  lane :test do
    sh("cd .. && bash Scripts/setup.sh")

    run_tests(
      workspace: WORKSPACE,
      scheme: SCHEME,
      device: "iPhone 17 Pro",
      # The suite covers pure logic only, so there is nothing to retry and no
      # simulator state to reset between runs.
      reset_simulator: false
    )
  end

  desc "Build and upload to TestFlight. Options: version:1.2.0 sets the marketing version (else TUIST_MARKETING_VERSION, else the manifest default)"
  lane :beta do |options|
    # Set before generation: the manifest reads it into MARKETING_VERSION.
    ENV["TUIST_MARKETING_VERSION"] = options[:version].to_s if options[:version]
    verify_release_environment!

    sh("cd .. && bash Scripts/setup.sh")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("AUTH_KEY_PATH"),
      in_house: false
    )

    # Registers the bundle id and creates the App Store Connect record the first
    # time this app is uploaded — the rename to com.coby.ringring left it without
    # one. `produce` is idempotent: once the app exists this is a no-op.
    produce(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_name: APP_NAME,
      language: APP_PRIMARY_LANGUAGE,
      sku: APP_IDENTIFIER
    )

    # Latest TestFlight build + 1. A brand-new app has no builds, so the lookup
    # falls back to 0 rather than raising, and the first upload becomes build 1.
    build_number = ENV["BUILD_NUMBER"] || begin
      latest = latest_testflight_build_number(
        app_identifier: APP_IDENTIFIER,
        api_key: api_key,
        initial_build_number: 0
      )
      (latest.to_i + 1).to_s
    end

    output_directory = ENV["RUNNER_TEMP"] || File.expand_path("../build", __dir__)

    # App Store Connect API key auth. gym forwards xcargs to BOTH the archive and
    # the export xcodebuild invocations, so the auth flags are supplied once here
    # (duplicating them via export_xcargs makes xcodebuild reject the run).
    # Combined with export_options signingStyle=automatic and no local .p12,
    # Xcode creates/reuses a cloud-managed Apple Distribution certificate and
    # signs through Apple's servers — certificates never need manual rotation.
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: output_directory,
      clean: true,
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      },
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "CODE_SIGN_STYLE=Automatic",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath \"#{ENV.fetch("AUTH_KEY_PATH")}\"",
        "-authenticationKeyID \"#{ENV.fetch("APPSTORE_KEY_ID")}\"",
        "-authenticationKeyIssuerID \"#{ENV.fetch("APPSTORE_ISSUER_ID")}\""
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
